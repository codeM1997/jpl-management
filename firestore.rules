rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allows unauthenticated read on users collection so phone/email login lookup works
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default rule: all other documents require login
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
